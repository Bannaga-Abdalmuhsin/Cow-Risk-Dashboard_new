# ── Used when EAS runs WITHOUT git (EAS_NO_VCS=1 from this directory) ──
# All paths are relative to artifacts/team-tracker/

# Dependency directories (build server installs from package.json)
node_modules/

# Native build outputs
android/
ios/

# Expo and bundler cache
.expo/
dist/
web-build/

# Keys and secrets (uploaded separately via EAS submit config)
*.p8
*.p12
*.jks
google-service-account.json

# Dev noise
.DS_Store
npm-debug.*
yarn-debug.*
yarn-error.*
