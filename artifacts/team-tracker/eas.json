{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "24",
      "pnpm": "10",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://YOUR_REPLIT_DOMAIN/api"
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "24",
      "pnpm": "10",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://YOUR_REPLIT_DOMAIN/api"
      }
    },
    "preview-ios-device": {
      "distribution": "internal",
      "node": "24",
      "pnpm": "10",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://YOUR_REPLIT_DOMAIN/api"
      }
    },
    "production": {
      "node": "24",
      "pnpm": "10",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://YOUR_REPLIT_DOMAIN/api"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    }
  }
}
