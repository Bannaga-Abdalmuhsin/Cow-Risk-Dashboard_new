{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "24.0.0",
      "pnpm": "10.0.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://YOUR_REPLIT_DOMAIN/api"
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "24.0.0",
      "pnpm": "10.0.0",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://YOUR_REPLIT_DOMAIN/api"
      }
    },
    "preview-ios-device": {
      "distribution": "internal",
      "node": "24.0.0",
      "pnpm": "10.0.0",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://YOUR_REPLIT_DOMAIN/api"
      }
    },
    "production": {
      "node": "24.0.0",
      "pnpm": "10.0.0",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "distribution": "store"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://YOUR_REPLIT_DOMAIN/api"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      },
      "ios": {
        "ascApiKeyPath": "./AuthKey_WY3A9GMAC9.p8",
        "ascApiKeyIssuerId": "40ae93de-d0e8-4289-9988-2c17cf71e4c7",
        "ascApiKeyId": "WY3A9GMAC9",
        "ascAppId": "6770277029"
      }
    }
  }
}
