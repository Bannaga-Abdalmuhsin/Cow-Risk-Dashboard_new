{
  "expo": {
    "name": "ACES Field Team Tracker",
    "slug": "aces-field-team-tracker",
    "owner": "advanced-communications-and-electronics-systems-company",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "acesft",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F2EC"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.acesmsd.fieldtracker",
      "icon": "./assets/images/app-icon.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ACES Field Tracker shares your location with the operations manager during duty hours.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "ACES Field Tracker shares your location with the operations manager during duty hours."
      }
    },
    "android": {
      "package": "com.acesmsd.fieldtracker",
      "versionCode": 1,
      "icon": "./assets/images/app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon.png",
        "backgroundColor": "#F7F2EC"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/images/app-icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ACES Field Tracker shares your location with the operations manager during duty hours."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/app-icon.png",
          "color": "#8B1A1A",
          "defaultChannel": "field-ops"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
