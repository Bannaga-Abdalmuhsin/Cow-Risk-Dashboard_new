# pnpm content-addressable store (large, not needed by EAS build server)
.local

# pnpm workspace files — EAS server must NOT see these or it tries to install
# the entire monorepo instead of just artifacts/team-tracker
pnpm-lock.yaml
pnpm-workspace.yaml

# Root-level node_modules (build server installs its own from artifacts/team-tracker/package.json)
node_modules

# Other artifacts not needed for team-tracker build
artifacts/hajj-dashboard
artifacts/cow-risk-action-plan
artifacts/api-server
lib
scripts

# team-tracker build artifacts and generated dirs
artifacts/team-tracker/android/
artifacts/team-tracker/ios/
artifacts/team-tracker/.expo/
artifacts/team-tracker/dist/
artifacts/team-tracker/web-build/
artifacts/team-tracker/node_modules/

# Key/secret files (uploaded separately via submit config, not needed in archive)
artifacts/team-tracker/*.p8
artifacts/team-tracker/*.p12
artifacts/team-tracker/*.jks
artifacts/team-tracker/google-service-account.json

# Dev files
.DS_Store
npm-debug.*
yarn-debug.*
yarn-error.*
