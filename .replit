modules = ["nodejs-20", "postgresql-16"]

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 9999
externalPort = 5173

[[ports]]
localPort = 21597
externalPort = 3000

[[ports]]
localPort = 21598
externalPort = 4200

[[ports]]
localPort = 21599
externalPort = 5000

[[ports]]
localPort = 21600
externalPort = 6800

[[ports]]
localPort = 21601
externalPort = 6000

[[ports]]
localPort = 21602
externalPort = 8000

[[ports]]
localPort = 22337
externalPort = 80

[[ports]]
localPort = 22338
externalPort = 3002

[[ports]]
localPort = 22339
externalPort = 3003

[[ports]]
localPort = 24781
externalPort = 3001

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/api-server: api"

[[workflows.workflow]]
name = "artifacts/api-server: api"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[deployment]
deploymentTarget = "cloudrun"
build = ["pnpm", "--filter", "@workspace/hajj-dashboard", "run", "build"]

[agent]
expertMode = true

[userenv]

[userenv.shared]
FAULT_API_KEY = "87111651-41c9-4642-bfc2-4e1c35640af7"
FIREBASE_PROJECT_ID = "aces-field-team-tracker"
