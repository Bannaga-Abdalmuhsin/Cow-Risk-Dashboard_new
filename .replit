modules = ["nodejs-20", "postgresql-16", "python-3.11"]

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 21597
externalPort = 3000

[[ports]]
localPort = 21598
externalPort = 3003

[[ports]]
localPort = 21599
externalPort = 3001

[[ports]]
localPort = 24781
externalPort = 3002

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[deployment]
deploymentTarget = "static"
build = ["pnpm", "--filter", "@workspace/hajj-dashboard", "run", "build"]
publicDir = "artifacts/hajj-dashboard/dist/public"

[agent]
expertMode = true
